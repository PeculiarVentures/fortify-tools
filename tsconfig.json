{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "vitest-dom/extend-expect"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    // Resolved by Vite and Vitest too (resolve.tsconfigPaths in vite.config.ts).
    "paths": {
      "@testing": ["./utils/testing/index.ts"],
      "@testing/data": ["./utils/testing/data/index.ts"]
    }
  },
  "include": ["src", "utils", "*.config.ts", "setup-test.ts"]
}
