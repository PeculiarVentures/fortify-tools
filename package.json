{
  "name": "@peculiar/fortify-tools",
  "version": "2.0.16",
  "private": true,
  "homepage": "https://tools.fortifyapp.com",
  "license": "MIT",
  "author": "PeculiarVentures Team",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3003",
    "build": "vite build",
    "preview": "vite preview --port 3005",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "OXLINT_TSGOLINT_DANGEROUSLY_SUPPRESS_PROGRAM_DIAGNOSTICS=true oxlint",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@abraham/reflection": "^0.13.0",
    "@peculiar/certificates-viewer": "^5.2.1",
    "@peculiar/certificates-viewer-react": "^5.2.1",
    "@peculiar/fortify-client-core": "^6.0.0",
    "@peculiar/react-components": "^2.0.0",
    "@peculiar/utils": "^4.1.0",
    "@peculiar/x509": "^3.1.0",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "lodash-es": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.1.12",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0",
    "vitest-dom": "^0.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.7.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.5.0",
      "onFail": "warn"
    }
  }
